# Modo de depuração. `true` apenas para desenvolvimento local; em produção deve ser `false`.
DJANGO_DEBUG=true
# Chave secreta do Django. Em produção, defina um valor gerado e exclusivo.
DJANGO_SECRET_KEY=local-development-only-do-not-deploy
# Hosts permitidos, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Origens confiáveis para CSRF (ex.: https://app.exemplo.com), separadas por vírgula.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Redirecionamento para HTTPS. Vazio usa o padrão (ativo com DJANGO_DEBUG=false);
# defina `false` para testar a stack de produção localmente sem TLS.
DJANGO_SECURE_SSL_REDIRECT=

# Opcional: se POSTGRES_DB não estiver definida, utiliza SQLite.
# Com docker compose, defina POSTGRES_DB e POSTGRES_*; o compose já injeta POSTGRES_HOST=db.
# POSTGRES_DB=papertrail
# POSTGRES_USER=papertrail
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
